# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project artifacts (keep dirs, ignore large outputs)
artifacts/*.acmi
artifacts/*.txt.acmi
runs/*/
!artifacts/.gitkeep
!runs/.gitkeep

# Jupyter
.ipynb_checkpoints/
